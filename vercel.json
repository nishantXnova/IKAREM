{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "site/**", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/site/index.html" },
    { "src": "/migrate", "dest": "/site/migrate.html" },
    { "src": "/migrate.html", "dest": "/site/migrate.html" },
    { "src": "/reference", "dest": "/site/reference.html" },
    { "src": "/reference.html", "dest": "/site/reference.html" },
    { "src": "/recipes", "dest": "/site/recipes.html" },
    { "src": "/recipes.html", "dest": "/site/recipes.html" },
    { "src": "/guide", "dest": "/site/guide.html" },
    { "src": "/guide.html", "dest": "/site/guide.html" },
    { "src": "/style.css", "dest": "/site/style.css" },
    { "src": "/script.js", "dest": "/site/script.js" },
    { "src": "/favicon.ico", "dest": "/assets/ikarem-icon.svg" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|svg|png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, immutable" }]
    }
  ]
}
